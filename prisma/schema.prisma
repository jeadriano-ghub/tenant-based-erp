generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantType {
  CORPORATE
  SME
  ENTERPRISE
  GOVERNMENT
  NONPROFIT
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  GCASH
  MAYA
  CHECK
  CASH
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum LocationType {
  BRANCH
  WAREHOUSE
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  logoUrl   String?
  subdomain String     @unique
  type      TenantType @default(SME)

  contactPerson String
  email         String
  contactNo     String

  companyName        String
  industry           String
  tin                String?
  businessRegNo      String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  stateProvince      String?
  postalCode         String?
  country            String?  @default("Philippines")
  website            String?

  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  billingCycle      BillingCycle  @default(MONTHLY)
  paymentMethod     PaymentMethod @default(BANK_TRANSFER)
  status            TenantStatus  @default(PENDING)

  users         User[]
  roles         Role[]
  locations     Location[]
  notifications Notification[]
  auditLogs     AuditLog[]

  categories    Category[]
  brands        Brand[]
  suppliers     Supplier[]
  products      Product[]
  productSerials ProductSerial[]
  productBarcodes ProductBarcode[]
  productStockLevels ProductStockLevel[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  stockInItems StockInItem[]
  salesOrderItems SalesOrderItem[]
  quotationItems QuotationItem[]
  stockIns      StockIn[]
  salesOrders   SalesOrder[]
  quotations    Quotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model User {
  id        String  @id @default(cuid())
  tenantId  String? // NULL => platform admin (admin.erp.jra.com only)
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String
  email        String
  passwordHash String
  isSuperAdmin Boolean    @default(false)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?

  roles     UserRole[]
  locations UserLocation[]
  notifications Notification[]
  auditLogs AuditLog[]
  purchaseOrders PurchaseOrder[]
  salesOrders SalesOrder[]
  quotations Quotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([email])
}

// Permissions are the platform catalogue. Only platform admins manage these.
model Permission {
  id          String @id @default(cuid())
  key         String @unique // e.g. "tenant.create"
  module      String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
}

// Roles combine permissions. Tenants own their roles; tenantId NULL = platform role.
model Role {
  id          String  @id @default(cuid())
  tenantId    String?
  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean @default(false)

  permissions RolePermission[]
  users       UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Location {
  id       String       @id @default(cuid())
  tenantId String
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code     String
  name     String
  type     LocationType @default(BRANCH)
  address  String?
  city     String?
  contactNo String?
  isActive Boolean      @default(true)

  users UserLocation[]
  stockLevels ProductStockLevel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model UserLocation {
  userId     String
  locationId String
  isPrimary  Boolean @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// Audit trail for record changes. tenantId is NULL for platform/admin changes,
// otherwise the tenant that owns the record — kept under the same tenant
// segregation as notifications so no tenant sees another's history.
model AuditLog {
  id        String      @id @default(cuid())
  tenantId  String?
  tenant    Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  entity    String // Tenant | User | Role | Location | Permission
  entityId  String
  entityName String? // human-readable label of the affected record
  action    AuditAction
  before    Json?
  after     Json?
  createdAt DateTime    @default(now())

  @@index([tenantId])
  @@index([entity, entityId])
  @@index([createdAt])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// Notifications are scoped by tenantId: NULL = platform/admin, otherwise the
// tenant that owns them. A notification is never visible outside its tenant.
model Notification {
  id         String           @id @default(cuid())
  tenantId   String? // NULL => platform/admin notifications
  tenant     Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientId String? // NULL => broadcast to everyone in the tenant
  recipient  User?            @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  title      String
  message    String
  type       NotificationType @default(INFO)
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([tenantId])
  @@index([recipientId])
}

// ---------------------------
// Inventory Module
// -------------------

enum ProductType {
  SERIALIZED
  NON_SERIALIZED
  BARCODE
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  TRANSFER
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}

model Category {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean   @default(true)

  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, parentId])
}

model Brand {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  website     String?
  isActive    Boolean @default(true)

  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@unique([tenantId, name])
}

model Supplier {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  contactPerson  String?
  email          String?
  contactNo      String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  stateProvince  String?
  postalCode     String?
  country        String?  @default("Philippines")
  tin            String?
  businessRegNo  String?
  notes          String?
  isActive       Boolean   @default(true)

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, name])
}

model Product {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category     @relation(fields: [categoryId], references: [id])
  brandId         String?
  brand           Brand?       @relation(fields: [brandId], references: [id])
  sku             String
  name            String
  description     String?
  productType     ProductType  @default(NON_SERIALIZED)
  unitOfMeasure   String?      @default("pc")
  costPrice       Decimal?     @db.Decimal(12, 2)
  sellingPrice    Decimal?     @db.Decimal(12, 2)
  minStockLevel   Int?         @default(0)
  reorderPoint    Int?         @default(0)
  isActive        Boolean      @default(true)

  purchaseOrderItems PurchaseOrderItem[]
  stockInItems       StockInItem[]
  salesOrderItems    SalesOrderItem[]
  quotationItems     QuotationItem[]
  stockMovements     StockMovement[]
  serials            ProductSerial[]
  barcodes           ProductBarcode[]
  stockLevels        ProductStockLevel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@index([tenantId, sku])
  @@unique([tenantId, sku])
}

model ProductSerial {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  serialNo   String
  status     String   @default("AVAILABLE") // AVAILABLE, RESERVED, SOLD, SCRAPPED
  metadata   Json?

  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, productId])
  @@unique([tenantId, serialNo])
}

model ProductBarcode {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcode   String
  format    String?  @default("CODE128")
  isPrimary Boolean  @default(false)
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, productId])
  @@unique([tenantId, barcode])
}

model ProductStockLevel {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  quantity   Int      @default(0)
  reserved   Int      @default(0)

  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, locationId])
  @@unique([tenantId, productId, locationId])
}

model StockMovement {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  stockLevelId String?
  stockLevel   ProductStockLevel? @relation(fields: [stockLevelId], references: [id])
  serialId     String?
  serial       ProductSerial?    @relation(fields: [serialId], references: [id])
  purchaseOrderId String?
  purchaseOrder PurchaseOrder?   @relation("PurchaseOrderStockMovements", fields: [purchaseOrderId], references: [id])
  salesOrderId String?
  salesOrder   SalesOrder?       @relation("SalesOrderStockMovements", fields: [salesOrderId], references: [id])
  type         StockMovementType
  quantity     Int
  reference    String?
  notes        String?
  createdAt    DateTime          @default(now())

  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
}

model PurchaseOrder {
  id              String             @id @default(cuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  status          PurchaseOrderStatus @default(DRAFT)
  referenceNo     String?
  expectedDate    DateTime?
  receivedDate    DateTime?
  notes           String?
  createdById     String?
  createdBy       User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  items           PurchaseOrderItem[]
  stockIns        StockIn[]
  stockMovements  StockMovement[] @relation("PurchaseOrderStockMovements")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  tenantId        String
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int
  unitCost        Decimal @db.Decimal(12, 2)
  receivedQty     Int     @default(0)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, purchaseOrderId])
}

model StockIn {
  id              String  @id @default(cuid())
  tenantId        String
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  referenceNo     String?
  receivedBy      String?
  notes           String?
  receivedAt      DateTime @default(now())

  items StockInItem[]

  @@index([tenantId])
}

model StockInItem {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockInId   String
  stockIn     StockIn @relation(fields: [stockInId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int
  unitCost    Decimal @db.Decimal(12, 2)
  expiryDate  DateTime?
  batchNo     String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, stockInId])
}

model SalesOrder {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerName  String
  customerEmail String?
  contactNo     String?
  shippingAddress Json?
  status        SalesOrderStatus @default(DRAFT)
  referenceNo   String?
  notes         String?
  createdById   String?
  createdBy     User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  items         SalesOrderItem[]
  stockMovements StockMovement[] @relation("SalesOrderStockMovements")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
}

model SalesOrderItem {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrderId String
  salesOrder  SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @db.Decimal(12, 2) @default(0)
  tax         Decimal @db.Decimal(12, 2) @default(0)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, salesOrderId])
}

model Quotation {
  id            String            @id @default(cuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerName  String
  customerEmail String?
  contactNo     String?
  expiryDate    DateTime?
  status        QuotationStatus   @default(DRAFT)
  referenceNo   String?
  convertedToId String?
  notes         String?
  createdById   String?
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  items QuotationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
}

model QuotationItem {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotationId String
  quotation  Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  discount   Decimal @db.Decimal(12, 2) @default(0)
  tax        Decimal @db.Decimal(12, 2) @default(0)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, quotationId])
}
